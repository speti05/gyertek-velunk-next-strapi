# these keys/files are only for local development
# create a .env.local file in the client folder and copy the content of this file into it, then modify the values as needed

# in prod, its in the github secrets, see it in the docker file
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here
# in prod,they are github variables, see it in the docker file
# this G-xyz.. value should come from a Google Analytics property , see https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# in prod, it is a GitHub Actions Variable (vars.NEXT_PUBLIC_STRAPI_URL), e.g.
# https://admin.gyertekvelunk.eu - see the docker file
#
# The PUBLIC Strapi origin, used for media URLs (client components and Next's
# image optimizer both need a host reachable from outside the Docker network)
# and for the CSP frame-ancestors header. Server-side API calls use
# STRAPI_API_URL instead, which stays on the internal Docker network.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# in prod, it is a GitHub Actions Variable (vars.NEXT_PUBLIC_SITE_URL), e.g.
# https://gyertekvelunk.eu - see the docker file
#
# The public URL of this site. Used for absolute URLs: metadata base, canonical
# and Open Graph links. On the Strapi side the same value is CLIENT_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# in prod, it should be in the root .env file
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here
# in prod, it should be in the root .env file
PREVIEW_SECRET=tobemodified

# in prod, it should be in the root .env file
# YouTube Data API v3 key, used server-side only to resolve a channel's uploads
# playlist for the Socials block embed (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
