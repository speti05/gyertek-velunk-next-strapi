# Final config, with TLS. Not loaded by nginx until moved into conf.d/
# (nginx only auto-loads *.conf files directly under conf.d/).
# Activate with:
#   mv deployment/nginx/gyertekvelunk.eu.conf.ssl deployment/nginx/conf.d/gyertekvelunk.eu.conf
#   docker compose exec nginx nginx -s reload
server {
    listen 80;
    listen [::]:80;
    server_name gyertekvelunk.eu www.gyertekvelunk.eu;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name gyertekvelunk.eu www.gyertekvelunk.eu;

    ssl_certificate     /etc/letsencrypt/live/gyertekvelunk.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gyertekvelunk.eu/privkey.pem;

    location / {
        proxy_pass http://client:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
