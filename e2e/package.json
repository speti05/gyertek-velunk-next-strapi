{
  "name": "e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Gyertek Velunk end-to-end tests (Playwright)",
  "scripts": {
    "test": "node scripts/run.mjs",
    "test:ui": "node scripts/run.mjs --ui",
