{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@client/*": ["../client/src/*"],
      "@server/*": ["../server/src/*"],
      // The client files imported here (i18n/texts.ts) use the client's own alias
      "@/*": ["../client/src/*"]
    }
  },
  "include": ["**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
