# Strapi secrets
HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

#email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=admin@yourapp.com
# for strapi preview plugin
CLIENT_URL=https://yoursite.com
# for enabling strapi preview mode, have to match with the value in clients env file
PREVIEW_SECRET=tobemodified
# gyertekvelunk url, for newsletter sending
SITE_URL=https://yoursite.com
# public URL of the Strapi API (used in unsubscribe links)
STRAPI_URL=https://api.yoursite.com
# secret for signing unsubscribe tokens (any long random string)
NEWSLETTER_UNSUBSCRIBE_SECRET=tobemodified

# Postgres connection - values must match DATABASE_NAME/USERNAME/PASSWORD in the
# root .env on the VPS (that file provisions the postgres container itself)
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=tobemodified
DATABASE_SSL=false
