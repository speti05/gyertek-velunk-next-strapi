{
  "collectionName": "components_blocks_youtube_videos",
  "info": {
    "displayName": "Youtube Video"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "videoUrl": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "aspectRatio": {
      "type": "enumeration",
      "enum": [
        "16:9",
        "9:16"
      ],
      "default": "16:9"
    },
    "startTime": {
      "type": "integer",
      "min": 0
    },
    "privacyMode": {
      "type": "boolean",
      "default": true
    }
  }
}
