{
  "kind": "collectionType",
  "collectionName": "newsletters",
  "info": {
    "singularName": "newsletter",
    "pluralName": "newsletters",
    "displayName": "Newsletter",
    "description": "Newsletter küldés a feliratkozóknak"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "subject": {
      "type": "string",
      "required": true
    },
    "sentAt": {
      "type": "datetime"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "body": {
      "type": "blocks"
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.paragraph",
        "blocks.paragraph-with-image",
        "blocks.hero-section",
        "blocks.heading",
        "blocks.full-image",
        "blocks.youtube-video",
        "blocks.picture-gallery"
      ]
    }
  }
}
