# Example of environment variables and secrets for local development

# Strapi secrets
APP_KEYS=fill_it_out
HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

#email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=admin@yourapp.com
# public URL of the Next.js frontend. Used for the strapi preview plugin, for the
# e-mail confirmation / password reset redirects, and for links in outgoing e-mails.
CLIENT_URL=http://localhost:3000
# for enabling strapi preview mode, have to match with the value in clients env file
PREVIEW_SECRET=tobemodified
# public URL of the Strapi API. Used in unsubscribe links, and as server.url in
# config/server.ts - that is what Strapi puts in the e-mail confirmation link.
# Without it the links point at http://0.0.0.0:1337 and are dead.
STRAPI_URL=http://localhost:1337
# secret for signing unsubscribe tokens (any long random string)
NEWSLETTER_UNSUBSCRIBE_SECRET=tobemodified