# in production, place a filled copy to VPS 
# into /opt/gyertek-velunk/.env


# recapthcha
# generate here:https://www.google.com/recaptcha/admin/
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here
# for enabling strapi preview mode(have to match with servers PREVIEW_SECRET key)
# have to match with the servers PREVIEW_SECRET key
PREVIEW_SECRET=tobemodified
# YouTube Data API v3 key, used server-side by the client for the Socials block embed
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Postgres credentials, used by docker-compose to provision the postgres
# container AND must match DATABASE_NAME/USERNAME/PASSWORD in server/.env.production
# (production only - local dev keeps using sqlite)
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=tobemodified
